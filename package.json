{
  "name": "ixora-studio",
  "version": "2.5.2",
  "private": true,
  "description": "IXORA Studio offline manual photo editor and file toolkit",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node --check server.js && node --check app.js",
    "lint": "node --check server.js && node --check app.js",
    "android:prepare": "node scripts/prepare-android.js && (npx cap add android || true) && npx cap sync android",
    "check": "node --check app.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@imgly/background-removal": "1.4.5",
    "@imgly/background-removal-data": "1.4.5",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.28.2"
  }
}
